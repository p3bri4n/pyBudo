  {
    "id": "kyu_5_mots_longueur",
    "kata_type": "function",
    "rank": "kyu_5",
    "discipline": "core",
    "variant_of": null,
    "title": "Compter les mots par longueur",
    "statement": "Écrivez une fonction qui reçoit une phrase et renvoie un dictionnaire associant chaque longueur de mot au nombre de mots ayant cette longueur.",
    "signature": "def compter_mots_par_longueur(texte: str) -> dict:",
    "solution_reference": "def compter_mots_par_longueur(texte):\n    mots = texte.split()\n    result = {}\n    for mot in mots:\n        longueur = len(mot)\n        result[longueur] = result.get(longueur, 0) + 1\n    return result",
    "tests": [
      {
        "input": [
          "le chat mange"
        ],
        "output": {
          "2": 1,
          "4": 1,
          "5": 1
        }
      },
      {
        "input": [
          ""
        ],
        "output": {}
      },
      {
        "input": [
          "a bb ccc dd e"
        ],
        "output": {
          "1": 2,
          "2": 2,
          "3": 1
        }
      },
      {
        "input": [
          "bonjour a tous"
        ],
        "output": {
          "7": 1,
          "1": 1,
          "4": 1
        }
      }
    ],
    "concepts_used": [
      "dict",
      "str.split",
      "fonction"
    ],
    "metadata": {
      "model": "claude",
      "level_spec_version": "kyu_manuel-v1",
      "attempts": 1,
      "status": "publie",
      "violations_detected": []
    }
